# Copy to .env and fill in.
ANTHROPIC_API_KEY=
E2B_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Only for npm run migrate
DATABASE_URL=
# Comma-separated GitHub logins that skip the waitlist
ADMIN_LOGINS=
# Public URL of the site (OAuth redirect). Defaults to the request origin.
SITE_URL=http://localhost:3000
# Site-wide spend limit per UTC day, USD
DAILY_SPEND_LIMIT_USD=20
# Optional: PostHog analytics and session replay
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
